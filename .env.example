# Copy to .env (git-ignored). Phase 0 needs no external accounts.
POSTGRES_PASSWORD=sunhit
# Object store dev credentials live in infra/seaweedfs/s3.json.
# Set to true only to evaluate non-commercial data (e.g. GlobalBuildingAtlas, CC BY-NC).
ALLOW_NONCOMMERCIAL_SOURCES=false

# Phase 1 (CAMS) and Phase 2 (satellite) — not needed yet:
# COPERNICUS_ADS_KEY=
# EUMETSAT_CONSUMER_KEY=
# EUMETSAT_CONSUMER_SECRET=
