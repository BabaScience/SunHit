{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "windows.json",
  "title": "Windows",
  "description": "Sun windows per local day. Phase 0 is geometry only: p_sun is omitted.",
  "type": "object",
  "additionalProperties": false,
  "required": ["timezone", "model_version", "horizon_confidence", "days"],
  "definitions": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "start", "end", "minutes"],
      "properties": {
        "type": { "type": "string", "enum": ["sun", "filtered", "blocked"] },
        "start": { "type": "string", "format": "date-time", "description": "ISO 8601 in the spot's timezone" },
        "end": { "type": "string", "format": "date-time" },
        "minutes": { "type": "number" },
        "by": { "type": "string", "enum": ["surface", "terrain", "building", "tree", "user"], "description": "What blocks or filters the sun during the segment" },
        "transmissivity": { "type": "number", "minimum": 0, "maximum": 1, "description": "Share of direct light passing through canopy (filtered segments)" },
        "blocked_after_by": { "type": "string", "enum": ["surface", "terrain", "building", "tree", "user", "sunset"], "description": "What ends the segment" },
        "p_sun": { "type": "number", "minimum": 0, "maximum": 1, "description": "From Phase 1" }
      }
    },
    "day": {
      "type": "object",
      "additionalProperties": false,
      "required": ["date", "segments", "geometric_windows", "expected_sun_minutes", "filtered_minutes"],
      "properties": {
        "date": { "type": "string", "format": "date" },
        "segments": { "type": "array", "items": { "$ref": "#/definitions/segment" } },
        "geometric_windows": { "type": "array", "items": { "$ref": "#/definitions/segment" }, "description": "Only the sun segments" },
        "expected_sun_minutes": { "type": "number" },
        "filtered_minutes": { "type": "number" }
      }
    }
  },
  "properties": {
    "spot_id": { "type": "string" },
    "timezone": { "type": "string" },
    "model_version": { "type": "string" },
    "horizon_confidence": { "type": "string", "enum": ["modelled", "calibrated", "none"] },
    "days": { "type": "array", "items": { "$ref": "#/definitions/day" } }
  }
}
